<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="6dp" android:background="@drawable/round_surface"
    android:foreground="?attr/selectableItemBackground" android:orientation="vertical" android:padding="8dp">
    <ImageView android:id="@+id/thumb" android:layout_width="match_parent" android:layout_height="190dp"
        android:background="#3A3D41" android:scaleType="fitCenter" />
    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="2"
        android:textColor="@color/text" android:textSize="14sp" />
    <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="@color/text_dim" android:textSize="12sp" />
</LinearLayout>
