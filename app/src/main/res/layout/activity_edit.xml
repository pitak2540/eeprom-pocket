<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back"
            android:contentDescription="กลับ" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:drawableEnd="@drawable/ic_edit" android:drawablePadding="8dp"
            android:ellipsize="middle" android:paddingHorizontal="8dp" android:paddingVertical="8dp"
            android:singleLine="true" android:textColor="@color/text" android:textSize="17sp" />
        <TextView android:id="@+id/btnAdd" android:layout_width="wrap_content" android:layout_height="48dp"
            android:background="?attr/selectableItemBackground" android:gravity="center"
            android:paddingHorizontal="12dp" android:text="เพิ่ม" android:textColor="@color/teal"
            android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:id="@+id/page" android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="20dp" android:scaleType="fitCenter" android:contentDescription="หน้าเอกสาร" />
        <ProgressBar android:id="@+id/busy" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center" android:visibility="gone" />
    </FrameLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp"
        android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp"
        android:background="@drawable/round_surface" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/btnPrev" android:layout_width="48dp" android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_prev"
            android:contentDescription="หน้าก่อน" />
        <TextView android:id="@+id/pageNo" android:layout_width="64dp" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/text" android:textSize="16sp" />
        <ImageButton android:id="@+id/btnNext" android:layout_width="48dp" android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_next"
            android:contentDescription="หน้าถัดไป" />
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface" android:scrollbars="none">
        <LinearLayout android:id="@+id/filters" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="6dp" android:paddingVertical="10dp" />
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/bg" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="6dp" android:paddingVertical="6dp">
        <TextView android:id="@+id/btnRetake" style="@style/ToolBtn" android:drawableTop="@drawable/ic_camera" android:text="ถ่ายใหม่" />
        <TextView android:id="@+id/btnRotate" style="@style/ToolBtn" android:drawableTop="@drawable/ic_rotate_left" android:text="หมุนซ้าย" />
        <TextView android:id="@+id/btnCrop" style="@style/ToolBtn" android:drawableTop="@drawable/ic_crop" android:text="ครอป" />
        <TextView android:id="@+id/btnDelete" style="@style/ToolBtn" android:drawableTop="@drawable/ic_delete" android:text="ลบหน้า" />
        <ImageButton android:id="@+id/btnOk" android:layout_width="76dp" android:layout_height="52dp"
            android:layout_marginStart="6dp" android:background="@drawable/btn_teal" android:src="@drawable/ic_check"
            android:contentDescription="บันทึก" />
    </LinearLayout>
</LinearLayout>
